<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_mobile_banner_tree" model="ir.ui.view">
        <field name="name">mobile.banner.list</field>
        <field name="model">mobile.banner</field>
        <field name="arch" type="xml">
            <list string="Mobile Promotion Banners">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mobile_banner_form" model="ir.ui.view">
        <field name="name">mobile.banner.form</field>
        <field name="model">mobile.banner</field>
        <field name="arch" type="xml">
            <form string="Mobile Promotion Banner">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="action_type"/>
                            <field name="category_id" invisible="action_type != 'category'" required="action_type == 'category'"/>
                            <field name="product_id" invisible="action_type != 'product'" required="action_type == 'product'"/>
                            <field name="custom_url" invisible="action_type != 'url'" required="action_type == 'url'"/>
                        </group>
                    </group>
                    <group string="Banner Asset">
                        <field name="image" widget="image" class="oe_avatar" options="{'size': [512, 256]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mobile_banner" model="ir.actions.act_window">
        <field name="name">Mobile App Banners</field>
        <field name="res_model">mobile.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first mobile app promotion banner!
            </p>
            <p>
                Banners uploaded here will automatically sync and display on the homepage slider of your Flutter mobile app client.
            </p>
        </field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_mobile_app_root" name="Mobile App" web_icon="odoo_mobile_connector,static/description/icon.png" sequence="60"/>
    <menuitem id="menu_mobile_banner" name="Homepage Banners" parent="menu_mobile_app_root" action="action_mobile_banner" sequence="10"/>
</odoo>

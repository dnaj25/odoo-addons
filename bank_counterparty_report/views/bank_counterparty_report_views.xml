<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bank_counterparty_report_list" model="ir.ui.view">
        <field name="name">bank.counterparty.report.list</field>
        <field name="model">bank.counterparty.report</field>
        <field name="arch" type="xml">
            <list string="Bank Counterparty Report" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="journal_id"/>
                <field name="bank_account_id"/>
                <field name="counterparty_account_id"/>
                <field name="partner_id"/>
                <field name="payment_ref"/>
                <field name="type" widget="badge"/>
                <field name="amount" sum="Total Amount"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_bank_counterparty_report_pivot" model="ir.ui.view">
        <field name="name">bank.counterparty.report.pivot</field>
        <field name="model">bank.counterparty.report</field>
        <field name="arch" type="xml">
            <pivot string="Bank Counterparty Analysis">
                <field name="counterparty_account_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bank_counterparty_report_search" model="ir.ui.view">
        <field name="name">bank.counterparty.report.search</field>
        <field name="model">bank.counterparty.report</field>
        <field name="arch" type="xml">
            <search string="Search Bank Counterparty Report">
                <field name="partner_id"/>
                <field name="bank_account_id"/>
                <field name="counterparty_account_id"/>
                <field name="payment_ref"/>
                
                <separator/>
                <filter string="Incoming (الوارد)" name="incoming" domain="[('type', '=', 'incoming')]"/>
                <filter string="Outgoing (المنصرف)" name="outgoing" domain="[('type', '=', 'outgoing')]"/>
                
                <group>
                    <filter string="Partner" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Bank Account" name="group_bank_account" context="{'group_by':'bank_account_id'}"/>
                    <filter string="Counterparty Account" name="group_counterparty" context="{'group_by':'counterparty_account_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bank_counterparty_report" model="ir.actions.act_window">
        <field name="name">Bank Counterparty Report</field>
        <field name="res_model">bank.counterparty.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_bank_counterparty_report_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bank counterparty transactions found!
            </p>
            <p>
                Make sure bank journal entries are posted and reconciled.
            </p>
        </field>
    </record>

    <!-- Menu Item under Accounting -> Reporting -->
    <menuitem id="menu_bank_counterparty_report"
              name="Bank Counterparty Report"
              parent="account.menu_finance_reports"
              action="action_bank_counterparty_report"
              sequence="100"/>
</odoo>

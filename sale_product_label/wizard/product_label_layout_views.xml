<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_layout_form_sale" model="ir.ui.view">
        <field name="name">product.label.layout.form.sale</field>
        <field name="model">product.label.layout</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <xpath expr='//field[@name="custom_quantity"]' position="before">
                <field name="sale_quantity" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <xpath expr="//field[@name='custom_quantity']" position="attributes">
                <attribute name="invisible">sale_quantity == 'sale'</attribute>
            </xpath>
        </field>
    </record>
</odoo>

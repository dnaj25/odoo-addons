<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(whatsapp_web_integration.action_whatsapp_message_wizard)d" 
                        type="action" 
                        class="oe_stat_button" 
                        icon="fa-comments"
                        invisible="not phone">
                    <div class="o_stat_info">
                        <span class="o_stat_text">WhatsApp</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

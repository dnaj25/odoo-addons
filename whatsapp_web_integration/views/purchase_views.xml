<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_whatsapp" model="ir.ui.view">
        <field name="name">purchase.order.form.whatsapp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(whatsapp_web_integration.action_whatsapp_message_wizard)d" 
                        string="Send via WhatsApp" 
                        type="action" 
                        class="btn-secondary" 
                        invisible="state not in ('draft', 'sent', 'purchase')"/>
            </xpath>
        </field>
    </record>
</odoo>

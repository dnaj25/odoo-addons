<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Employee Separation -->
    <record id="seq_hr_employee_separation" model="ir.sequence">
        <field name="name">Employee Separation Sequence</field>
        <field name="code">hr.employee.separation</field>
        <field name="prefix">SEP/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Tree View -->
    <record id="view_hr_employee_separation_tree" model="ir.ui.view">
        <field name="name">hr.employee.separation.tree</field>
        <field name="model">hr.employee.separation</field>
        <field name="arch" type="xml">
            <list string="Employee Exit &amp; Settlements">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="last_day_date"/>
                <field name="departure_reason"/>
                <field name="total_settlement" decoration-bf="1"/>
                <field name="state" widget="badge" decoration-info="state == 'submit'" decoration-warning="state in ('hr_approve', 'finance_approve')" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_employee_separation_form" model="ir.ui.view">
        <field name="name">hr.employee.separation.form</field>
        <field name="model">hr.employee.separation</field>
        <field name="arch" type="xml">
            <form string="Employee Exit &amp; Settlement">
                <header>
                    <button name="action_compute_sheet" string="Compute Sheet" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit to HR" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_hr_approve" string="HR Approve" type="object" class="oe_highlight" invisible="state != 'submit'" groups="hr.group_hr_user"/>
                    <button name="action_finance_approve" string="Finance Approve" type="object" class="oe_highlight" invisible="state != 'hr_approve'" groups="account.group_account_invoice,account.group_account_manager"/>
                    <button name="action_done" string="Register Settlement" type="object" class="oe_highlight" invisible="state != 'finance_approve'" groups="account.group_account_invoice,account.group_account_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel', 'draft')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,hr_approve,finance_approve,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id"/>
                            <field name="joining_date"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group string="Separation Dates &amp; Reason">
                            <field name="request_date"/>
                            <field name="last_day_date"/>
                            <field name="departure_reason"/>
                            <field name="wage"/>
                        </group>
                    </group>
                    <notebook>
                        <tab string="Settlement Sheet">
                            <group>
                                <group string="Earnings &amp; Benefits">
                                    <field name="gratuity_amount"/>
                                    <field name="remaining_leaves"/>
                                    <field name="leave_encashment_amount"/>
                                    <field name="overtime_amount"/>
                                    <field name="other_allowances"/>
                                </group>
                                <group string="Deductions">
                                    <field name="loan_deduction"/>
                                    <field name="other_deductions"/>
                                </group>
                            </group>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_settlement" class="oe_subtotal_footer_separator" style="font-size: 1.5rem; font-weight: bold; color: #1e3a8a;"/>
                            </group>
                            <div class="oe_clear"/>
                        </tab>
                        <tab string="Notes">
                            <field name="notes" placeholder="Specify details, asset handovers, loans checklist..."/>
                        </tab>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_employee_separation_search" model="ir.ui.view">
        <field name="name">hr.employee.separation.search</field>
        <field name="model">hr.employee.separation</field>
        <field name="arch" type="xml">
            <search string="Search Exit &amp; Settlements">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submit')]"/>
                <filter string="Approved" name="approved" domain="[('state', 'in', ('hr_approve', 'finance_approve'))]"/>
                <filter string="Settled" name="settled" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_separation" model="ir.actions.act_window">
        <field name="name">Exit &amp; Final Settlements</field>
        <field name="res_model">hr.employee.separation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_separation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new employee exit and calculate settlement sheet.
            </p>
        </field>
    </record>

    <!-- Inherit Employee Form to add basic salary and joining date -->
    <record id="view_employee_form_separation_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.separation.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']" position="after">
                <page name="exit_settlement" string="Settlement &amp; Exit Settings" groups="hr.group_hr_user">
                    <group>
                        <group string="Employment Info">
                            <field name="joining_date"/>
                            <field name="basic_salary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hr_employee_separation"
              name="Exit &amp; Settlements"
              parent="hr.menu_hr_root"
              action="action_hr_employee_separation"
              sequence="95"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron 1: Auto-Post Due Installments -->
        <record id="ir_cron_auto_post_prepaid_entries" model="ir.cron">
            <field name="name">Prepaid Expenses: Auto-Post Due Installments</field>
            <field name="model_id" ref="model_prepaid_expense"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_post_prepaid_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron 2: Expiration & Last Month Renewal Alerts -->
        <record id="ir_cron_check_prepaid_expirations" model="ir.cron">
            <field name="name">Prepaid Expenses: Check Last-Month Expirations &amp; Renewal Alerts</field>
            <field name="model_id" ref="model_prepaid_expense"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_prepaid_expirations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

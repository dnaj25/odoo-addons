<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_prepaid_expense_tree" model="ir.ui.view">
        <field name="name">prepaid.expense.list</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <list string="Prepaid Expenses &amp; Rents" 
                  decoration-warning="renewal_state == 'expiring_soon'" 
                  decoration-danger="renewal_state == 'expired'"
                  decoration-success="state == 'confirmed' and renewal_state == 'normal'"
                  decoration-muted="state in ['cancelled', 'done']">
                <field name="name"/>
                <field name="title"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_amount" widget="monetary" sum="Total Prepaid Amount"/>
                <field name="posted_amount" widget="monetary" sum="Total Recognized"/>
                <field name="remaining_amount" widget="monetary" sum="Total Remaining"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="days_to_expire" string="Days Left"/>
                <field name="renewal_state" widget="badge" 
                       decoration-warning="renewal_state == 'expiring_soon'"
                       decoration-danger="renewal_state == 'expired'"
                       decoration-success="renewal_state == 'normal'"
                       decoration-info="renewal_state == 'renewed'"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'confirmed'" 
                       decoration-primary="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_prepaid_expense_form" model="ir.ui.view">
        <field name="name">prepaid.expense.form</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <form string="Prepaid Expense Contract">
                <header>
                    <button name="action_compute_schedule" string="⚡ Generate Schedule" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="✅ Confirm &amp; Activate" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_post_due_entries" string="📘 Post Due Entries" type="object" 
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_renew" string="🔄 Renew Contract" type="object" 
                            class="btn-primary" invisible="state not in ['confirmed', 'done']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state not in ['cancelled']"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ['done', 'cancelled']"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Visual Alert Ribbons -->
                    <widget name="web_ribbon" title="⚠️ Expiring Soon" bg_color="text-bg-warning" 
                            invisible="renewal_state != 'expiring_soon'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" 
                            invisible="renewal_state != 'expired'"/>
                    <widget name="web_ribbon" title="Renewed" bg_color="text-bg-info" 
                            invisible="renewal_state != 'renewed'"/>
                    <widget name="web_ribbon" title="Fully Recognized" bg_color="text-bg-success" 
                            invisible="state != 'done'"/>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entries" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="title" string="Contract / Prepaid Expense Title"/>
                        <h1>
                            <field name="title" placeholder="e.g., Head Office Annual Rent 2026..."/>
                        </h1>
                        <div class="text-muted">
                            <span>Reference: </span>
                            <field name="name" readonly="1" class="fw-bold"/>
                        </div>
                    </div>

                    <group>
                        <group string="Contract &amp; Partner Info">
                            <field name="category_id" options="{'no_create': False}"/>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Duration &amp; Deduction Schedule">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="periodicity"/>
                            <field name="number_of_periods"/>
                            <field name="reminder_days_before" string="Last-Month Alert (Days)"/>
                            <field name="auto_post"/>
                        </group>
                    </group>

                    <group>
                        <group string="Accounting &amp; Financial Setup">
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="prepaid_account_id"/>
                            <field name="expense_account_id"/>
                            <field name="journal_id"/>
                            <field name="source_invoice_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Live Balances &amp; Renewal Status">
                            <field name="posted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="remaining_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="posted_lines_count" string="Recognized Installments"/>
                            <field name="lines_count" string="Total Installments"/>
                            <field name="days_to_expire" string="Days Remaining to Expire"/>
                            <field name="renewal_state" widget="badge" 
                                   decoration-warning="renewal_state == 'expiring_soon'"
                                   decoration-danger="renewal_state == 'expired'"
                                   decoration-success="renewal_state == 'normal'"
                                   decoration-info="renewal_state == 'renewed'"/>
                            <field name="is_expiring_soon" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📅 Recognition Schedule (Monthly Installments)" name="schedule_lines">
                            <field name="line_ids">
                                <list string="Installments" editable="bottom" 
                                      decoration-success="state == 'posted'" 
                                      decoration-muted="state == 'cancelled'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="move_id" widget="many2one"/>
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'draft'" 
                                           decoration-success="state == 'posted'" 
                                           decoration-danger="state == 'cancelled'"/>
                                    <button name="action_post_entry" string="Recognize &amp; Post" type="object" 
                                            icon="fa-check-circle" class="btn-success" 
                                            invisible="state != 'draft'"/>
                                    <button name="action_view_move" string="View Entry" type="object" 
                                            icon="fa-external-link" 
                                            invisible="not move_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="📝 Contract Notes &amp; Terms" name="notes">
                            <field name="notes" placeholder="Specify landlord terms, renewal conditions, policy numbers, or contract clauses..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_prepaid_expense_kanban" model="ir.ui.view">
        <field name="name">prepaid.expense.kanban</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="title"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="total_amount"/>
                <field name="remaining_amount"/>
                <field name="currency_id"/>
                <field name="end_date"/>
                <field name="renewal_state"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 rounded shadow-sm bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="o_kanban_record_title text-primary"><field name="name"/></strong>
                                <field name="state" widget="badge" 
                                       decoration-info="state == 'draft'" 
                                       decoration-success="state == 'confirmed'" 
                                       decoration-primary="state == 'done'"/>
                            </div>
                            <div class="mb-2">
                                <div class="fw-bold mb-1"><field name="title"/></div>
                                <div class="text-muted small"><field name="category_id"/></div>
                                <div class="text-muted small"><field name="partner_id"/></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                <div>
                                    <small class="text-muted d-block">Remaining</small>
                                    <strong class="text-success"><field name="remaining_amount" widget="monetary"/></strong>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">Expires On</small>
                                    <field name="end_date"/>
                                </div>
                            </div>
                            <div class="mt-2">
                                <field name="renewal_state" widget="badge"
                                       decoration-warning="renewal_state == 'expiring_soon'"
                                       decoration-danger="renewal_state == 'expired'"
                                       decoration-success="renewal_state == 'normal'"
                                       decoration-info="renewal_state == 'renewed'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search / Filter View -->
    <record id="view_prepaid_expense_search" model="ir.ui.view">
        <field name="name">prepaid.expense.search</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <search string="Search Prepaid Expenses">
                <field name="name" string="Contract Reference"/>
                <field name="title"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                
                <separator/>
                <filter name="filter_expiring_soon" string="⚠️ Expiring Soon (Final Month Alert)" 
                        domain="[('renewal_state', '=', 'expiring_soon')]"/>
                <filter name="filter_confirmed" string="Active &amp; Confirmed" 
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_draft" string="Draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_done" string="Fully Recognized (Closed)" 
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_expired" string="Expired" 
                        domain="[('renewal_state', '=', 'expired')]"/>
                <filter name="filter_renewed" string="Renewed" 
                        domain="[('renewal_state', '=', 'renewed')]"/>
                
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_partner" string="Vendor / Landlord" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_renewal_state" string="Renewal Status" context="{'group_by': 'renewal_state'}"/>
                    <filter name="group_state" string="Contract Status" context="{'group_by': 'state'}"/>
                    <filter name="group_periodicity" string="Recognition Frequency" context="{'group_by': 'periodicity'}"/>
                    <filter name="group_end_date" string="End Month" context="{'group_by': 'end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_prepaid_expense_graph" model="ir.ui.view">
        <field name="name">prepaid.expense.graph</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <graph string="Prepaid Expenses Analysis" type="bar">
                <field name="category_id"/>
                <field name="total_amount" type="measure"/>
                <field name="posted_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_prepaid_expense_pivot" model="ir.ui.view">
        <field name="name">prepaid.expense.pivot</field>
        <field name="model">prepaid.expense</field>
        <field name="arch" type="xml">
            <pivot string="Prepaid Expenses Pivot">
                <field name="category_id" type="row"/>
                <field name="periodicity" type="col"/>
                <field name="total_amount" type="measure"/>
                <field name="posted_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Window Action: All Expenses -->
    <record id="action_prepaid_expense" model="ir.actions.act_window">
        <field name="name">Prepaid Expenses &amp; Rents</field>
        <field name="res_model">prepaid.expense</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_prepaid_expense_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Prepaid Expense or Lease Contract!
            </p>
            <p>
                Manage office rents, software subscriptions, insurance policies, and annual contracts 
                with automated monthly journal deductions and renewal alerts.
            </p>
        </field>
    </record>

    <!-- Window Action: Expiring Soon Only -->
    <record id="action_prepaid_expense_expiring" model="ir.actions.act_window">
        <field name="name">⚠️ Expiring Contracts (Last Month Renewal Alerts)</field>
        <field name="res_model">prepaid.expense</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_prepaid_expense_search"/>
        <field name="domain">[('renewal_state', '=', 'expiring_soon')]</field>
        <field name="context">{'search_default_filter_expiring_soon': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No contracts currently expiring in their final month.
            </p>
            <p>
                Contracts entering their last month or custom renewal notice period will automatically appear here.
            </p>
        </field>
    </record>
</odoo>

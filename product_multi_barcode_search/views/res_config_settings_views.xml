<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_multi_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.multi.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Extra Barcodes (الباركود الإضافي)" name="product_multi_barcode_settings">
                    <setting string="Unique Extra Barcodes" help="Enforce unique validation on extra product barcodes (تفعيل فرادة الباركود الإضافي للمنتجات).">
                        <field name="module_product_multi_barcode_search_uniq"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

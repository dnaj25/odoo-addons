<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for AI Dashboard -->
    <record id="action_switch_ai_dashboard" model="ir.actions.client">
        <field name="name">AI Dashboard Studio</field>
        <field name="tag">switch_ai_dashboard.action</field>
        <field name="target">current</field>
    </record>

    <!-- Submenu under standard Dashboards root menu -->
    <menuitem id="menu_switch_ai_dashboard"
              name="AI Dashboard"
              action="action_switch_ai_dashboard"
              parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
              sequence="5"/>
</odoo>

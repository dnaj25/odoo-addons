<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_type_list" model="ir.ui.view">
        <field name="name">contract.type.list</field>
        <field name="model">contract.type</field>
        <field name="arch" type="xml">
            <list string="Contract Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_contract_type" model="ir.actions.act_window">
        <field name="name">Contract Types</field>
        <field name="res_model">contract.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

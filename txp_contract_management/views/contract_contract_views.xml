<odoo>
    <!-- Tree View -->
    <record id="view_contract_contract_tree" model="ir.ui.view">
        <field name="name">contract.contract.tree</field>
        <field name="model">contract.contract</field>
        <field name="arch" type="xml">
            <tree string="Contracts" 
                  decoration-info="state == 'draft'" 
                  decoration-success="state == 'active'" 
                  decoration-warning="state == 'expiring'" 
                  decoration-danger="state == 'expired'" 
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="contract_type_id"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_to_expire"/>
                <field name="amount" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contract_contract_form" model="ir.ui.view">
        <field name="name">contract.contract.form</field>
        <field name="model">contract.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_renew" string="Renew Contract" type="object" class="oe_highlight" states="active,expiring,expired"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,active,expiring"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Office Rental Contract 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type_id"/>
                            <field name="partner_id"/>
                            <field name="employee_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days_to_expire"/>
                            <field name="alert_days"/>
                            <field name="amount" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Details">
                            <field name="notes" placeholder="Enter terms, conditions, or renewal policies..."/>
                        </page>
                        <page string="Renewal History">
                            <field name="renewal_log_ids" readonly="1">
                                <tree>
                                    <field name="renewal_date"/>
                                    <field name="old_end_date"/>
                                    <field name="new_start_date"/>
                                    <field name="new_end_date"/>
                                    <field name="new_amount"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View & Dashboard Filters -->
    <record id="view_contract_contract_search" model="ir.ui.view">
        <field name="name">contract.contract.search</field>
        <field name="model">contract.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type_id"/>
                <filter string="Expiring Soon" name="expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Contract Type" name="group_type" context="{'group_by':'contract_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by':'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>